generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tone {
  STRAIGHT_NEWS
  CONVERSATIONAL
  YOUTH_VOICE
}

enum PostStatus {
  DRAFT
  GENERATING
  EDITING
  IN_REVIEW
  SCHEDULED
  LIVE
  FAILED
}

enum AdminRole {
  ADMIN
  EDITOR
}

enum SourceType {
  rss
  html
}

model Source {
  id              String     @id @default(cuid())
  name            String
  type            SourceType @default(rss)
  url             String     @unique
  enabled         Boolean    @default(true)
  region          String     @default("")
  last_fetched_at DateTime?
  created_at      DateTime   @default(now())
  stories         Story[]

  @@map("sources")
}

model Settings {
  id             String @id @default(cuid())
  llm_provider   String @default("openai")
  llm_api_key    String @default("")
  llm_model      String @default("gpt-4o")
  video_provider String @default("stub")
  video_api_key  String @default("")
  video_model    String @default("stub-v1")
  defaultTone    Tone   @default(STRAIGHT_NEWS)

  audio_provider String @default("openai")
  audio_api_key  String @default("")
  audio_model    String @default("tts-1")
  audio_voice    String @default("onyx")
  llm_instructions      String   @default("")
  video_instructions    String   @default("")
  audio_instructions    String   @default("")

  supported_languages String[] @default(["en"])

  auto_publish_breaking Boolean @default(false)
  
  vapid_public_key  String @default("")
  vapid_private_key String @default("")

  @@map("settings")
}

model Story {
  id           String    @id @default(cuid())
  source_id    String
  source_url   String    @unique
  title        String
  raw_html     String    @default("")
  raw_text     String
  author       String?
  published_at DateTime?
  hash         String    @unique
  created_at   DateTime  @default(now())
  source       Source    @relation(fields: [source_id], references: [id])
  posts        Post[]

  @@index([source_id])
  @@index([created_at])
  @@map("stories")
}

model VideoAsset {
  id               String              @id @default(cuid())
  mp4_url          String
  thumb_url        String
  captions_url     String?
  duration_seconds Float               @default(0)
  thumb_candidates String[]            @default([])
  created_at       DateTime            @default(now())
  versions         GenerationVersion[]

  @@map("video_assets")
}

model GenerationVersion {
  id             String      @id @default(cuid())
  post_id        String
  tone           Tone
  llm_provider   String
  llm_model      String
  video_provider String
  video_model    String
  script_text    String      @default("")
  video_prompt   String      @default("")
  captions       String      @default("")
  flags_json     Json        @default("{}")
  character_ids  String[]    @default([])
  status         String      @default("PENDING")
  video_asset_id String?
  video_raw_url  String?
  error          String?
  created_at     DateTime    @default(now())
  post           Post        @relation(fields: [post_id], references: [id], onDelete: Cascade)
  videoAsset     VideoAsset? @relation(fields: [video_asset_id], references: [id])

  credits_used       Float @default(0)
  generation_time_ms Int   @default(0)
  language           String @default("en")

  @@index([post_id])
  @@map("generation_versions")
}

model Post {
  id                String              @id @default(cuid())
  story_id          String
  status            PostStatus          @default(DRAFT)
  tone              Tone                @default(STRAIGHT_NEWS)
  headline          String              @default("")
  caption           String              @default("")
  category          String              @default("General")
  tags              String[]            @default([])
  language          String              @default("en")
  region            String              @default("")
  active_version_id String?
  published_at_live DateTime?
  scheduled_at      DateTime?
  created_at        DateTime            @default(now())
  updated_at        DateTime            @updatedAt
  story             Story               @relation(fields: [story_id], references: [id])
  versions          GenerationVersion[]

  is_breaking      Boolean           @default(false)
  view_count       Int               @default(0)
  like_count       Int               @default(0)
  share_count      Int               @default(0)
  save_count       Int               @default(0)
  comment_count    Int               @default(0)
  userInteractions UserInteraction[]
  distributions    Distribution[]
  editorialNotes   EditorialNote[]
  comments         Comment[]

  @@index([status])
  @@index([created_at])
  @@map("posts")
}

model AdminUser {
  id            String    @id @default(cuid())
  email         String    @unique
  password_hash String
  role          AdminRole @default(EDITOR)
  created_at    DateTime  @default(now())

  @@map("admin_users")
}

model Character {
  id                String   @id @default(cuid())
  name              String
  role              String   @default("PUBLIC_FIGURE") // ANCHOR, PUBLIC_FIGURE, REPORTER
  description       String   @default("") // Prompt description for consistent generation
  image_urls        String[] @default([]) // Array of reference image URLs
  tags              String[] @default([]) // For auto-matching: "cricket", "jamaica", "politics"
  is_default_anchor Boolean  @default(false)
  voice_provider    String   @default("") // openai, elevenlabs, or empty to use global default
  voice_id          String   @default("") // voice ID (e.g. "onyx" for OpenAI, voice UUID for ElevenLabs)
  voice_model       String   @default("") // model override (e.g. "tts-1-hd")
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@map("characters")
}

model EditorialNote {
  id         String   @id @default(cuid())
  post_id    String
  author     String   @default("admin")
  message    String
  created_at DateTime @default(now())
  post       Post     @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@map("editorial_notes")
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  event_type String   // 'generation_started', 'generation_completed', 'generation_failed', 'post_published', 'tts_generated'
  post_id    String?
  provider   String?  // 'runway', 'openai', 'anthropic', etc.
  credits    Float    @default(0)
  metadata   Json?    // any extra data
  created_at DateTime @default(now())

  @@map("analytics_events")
}

model Distribution {
  id           String    @id @default(cuid())
  post_id      String
  platform     String    // 'tiktok', 'instagram', 'youtube', 'twitter'
  status       String    @default("PENDING") // PENDING, POSTED, FAILED
  platform_id  String?   // ID on the external platform
  platform_url String?   // URL on the external platform
  error        String?
  posted_at    DateTime?
  created_at   DateTime  @default(now())

  post Post @relation(fields: [post_id], references: [id])

  @@map("distributions")
}

model AppUser {
  id               String            @id @default(cuid())
  email            String?           @unique
  name             String            @default("")
  avatar_url       String            @default("")
  auth_provider    String            @default("email")
  auth_provider_id String            @default("")
  password_hash    String            @default("")
  preferences      Json              @default("{}")
  created_at       DateTime          @default(now())
  updated_at       DateTime          @updatedAt
  interactions     UserInteraction[]
  comments         Comment[]

  @@map("app_users")
}

model UserInteraction {
  id               String   @id @default(cuid())
  user_id          String
  post_id          String
  interaction_type String
  created_at       DateTime @default(now())
  user             AppUser  @relation(fields: [user_id], references: [id])
  post             Post     @relation(fields: [post_id], references: [id])

  @@unique([user_id, post_id, interaction_type])
  @@map("user_interactions")
}

model AdSlot {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("fullscreen")
  image_url   String   @default("")
  video_url   String   @default("")
  click_url   String   @default("")
  active      Boolean  @default(true)
  frequency   Int      @default(4)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  created_at  DateTime @default(now())

  @@map("ad_slots")
}

model Comment {
  id         String    @id @default(cuid())
  post_id    String
  user_id    String?
  parent_id  String?
  content    String
  like_count Int       @default(0)
  reported   Boolean   @default(false)
  created_at DateTime  @default(now())
  post       Post      @relation(fields: [post_id], references: [id], onDelete: Cascade)
  user       AppUser?  @relation(fields: [user_id], references: [id])
  parent     Comment?  @relation("CommentReplies", fields: [parent_id], references: [id])
  replies    Comment[] @relation("CommentReplies")

  @@index([post_id])
  @@map("comments")
}

model PushSubscription {
  id         String   @id @default(cuid())
  user_id    String?
  endpoint   String
  p256dh     String
  auth       String
  categories String[] @default([])
  created_at DateTime @default(now())

  @@map("push_subscriptions")
}
