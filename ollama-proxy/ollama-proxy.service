[Unit]
Description=Ollama OpenAI-Compatible API Proxy
After=network.target ollama.service
Requires=ollama.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/dashboard-host
ExecStart=/usr/bin/node /root/dashboard-host/ollama-proxy.js
Restart=always
RestartSec=10
Environment=OLLAMA_HOST=localhost:11434
Environment=PORT=11435
StandardOutput=append:/var/log/ollama-proxy.log
StandardError=append:/var/log/ollama-proxy-error.log

[Install]
WantedBy=multi-user.target
